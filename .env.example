# ==============================================================================
# StudyAI - Plantilla de Configuración de Variables de Entorno (.env.example)
# ==============================================================================
# Instrucciones:
# 1. Duplica este archivo y renómbralo a '.env'
# 2. Reemplaza el valor de OPENAI_API_KEY con tu clave de API real de OpenAI
# 3. Guarda el archivo. El archivo .env está excluido por .gitignore para no publicarse.
#
# NOTA: Si no configuras una clave API, StudyAI activará automáticamente el
# 'Modo Simulación Académica / Determinista' para que la Notebook pueda ejecutarse
# completamente sin errores de conexión ni costo.
# ==============================================================================

OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini